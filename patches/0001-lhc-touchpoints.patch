+    eprintln!(
+        "=== VERDICT INPUTS ready={ready}/{total} discarded={discarded} \
+         suspicious_logs={} sampler_calls={} first_touch_settle={} ===",
+        suspicious.len(),
+        recs.len(),
+        settled
