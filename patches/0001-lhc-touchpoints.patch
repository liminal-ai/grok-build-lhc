+fn message_text(blocks: &[lhc::messages::Block]) -> String {
+    blocks
+        .iter()
+        .filter_map(|b| b.content.get("text").and_then(|v| v.as_str()))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
