+
+    let thread_path = thread_file_path(root.path(), &sid);
+    let reader = init_lhc(SdkConfig {
+        inference_callbacks: Some(create_deterministic_inference_callbacks()),
+        inference: None,
+        mode: SdkMode::Manual,
