+    eprintln!(
+        "=== L3 G2 real write-back body ({} items, bands={bands}) ===\n{real_fp}",
+        body.len()
+    );
+    eprintln!("=== L3 G2 adapter fixture (kind sketch) ===\n{fixture_fp}");
+    if fingerprint_match {
